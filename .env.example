# Copier ce fichier en .env (ignore par git). Facultatif : charge uniquement par `npm run smoke`.
# Le stage se choisit toujours avec --stage : npm run smoke -- --stage dev-alice

# Region du stack (ne pas changer : le service est deploye en eu-west-1)
AWS_REGION=eu-west-1

# Adresse de base des comptes de test du smoke test (adressage +label, ex. vous+author-xxxx@...)
SMOKE_EMAIL=vous@example.com

# Facultatif : teste aussi l'abonnement (SNS envoie un email de confirmation a cette adresse)
# SMOKE_SUBSCRIBE_EMAIL=vous@example.com
